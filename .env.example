# ---- Frontend (build time) -------------------------------------------------
# Where the API lives. "/api" when the Node server serves the site.
# Leave empty to run in demo mode (data only on this device).
PUBLIC_API_URL=/api

# Map style (MapLibre). OpenFreeMap needs no key and sets no cookies.
PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/dark

# Plausible (EU) domain. Leave empty to disable analytics.
PUBLIC_PLAUSIBLE_DOMAIN=

# ---- Server (runtime) ------------------------------------------------------
PORT=8787
# SQLite lives here. Mount it as a volume on your EU host.
DATA_DIR=./data
# Set to true only behind your own reverse proxy (Caddy, nginx).
TRUST_PROXY=false

# Moderation API for n8n. Generate with: openssl rand -hex 32
ADMIN_TOKEN=
# Optional: every new report is POSTed here (your self-hosted n8n).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@example.nl
