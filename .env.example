# ---- Frontend (build time) -------------------------------------------------
# Where the API lives. Defaults to /api, served by the same Node process.
PUBLIC_API_URL=/api
# Set to true only for a server-less demo (data stays on the device).
PUBLIC_DEMO=false

# Map style. "self" = tiles from your own server (see docs/self-hosted-tiles.md).
# Any MapLibre style URL works too, for example OpenFreeMap:
# PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/dark
PUBLIC_MAP_STYLE=self
PUBLIC_TILES_FILE=netherlands.pmtiles

# Walking routes (OSRM API). Default: FOSSGIS in Germany. Self-host OSRM for full control.
PUBLIC_ROUTING_URL=https://routing.openstreetmap.de/routed-foot

# Plausible (EU) domain. Leave empty to disable analytics.
PUBLIC_PLAUSIBLE_DOMAIN=

# ---- Server (runtime) ------------------------------------------------------
PORT=8787
# SQLite lives here. Back this folder up every night.
DATA_DIR=./data
# Folder with the .pmtiles file, fonts/ and sprites/ for PUBLIC_MAP_STYLE=self.
TILES_DIR=./tiles
# Set to true only behind your own reverse proxy (Caddy, nginx).
TRUST_PROXY=false

# First moderator account for the partner portal (/partner), created at start.
MODERATOR_EMAIL=
MODERATOR_PASSWORD=
# Police accounts must sign up with an address on this domain.
POLICE_EMAIL_DOMAIN=politie.nl

# Moderation API token for you, volunteers and n8n. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# AI first pass on report notes. Any OpenAI-compatible endpoint:
# a model on your own server (Ollama: http://localhost:11434/v1, model llama3.1)
# or Mistral in the EU (https://api.mistral.ai/v1, model mistral-small-latest).
MODERATION_AI_URL=
MODERATION_AI_MODEL=
MODERATION_AI_KEY=

# Telegram alerts to the moderators' chat when a report needs a person.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: every new report is POSTed here (your n8n).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@example.nl
