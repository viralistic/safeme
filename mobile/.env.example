# The Safety Map server (same server as the website), with /api at the end.
# Leave empty to run the app in demo mode with example data on the phone.
EXPO_PUBLIC_API_URL=https://safetymap.example.nl/api

# Optional
EXPO_PUBLIC_WEB_URL=https://safetymap.example.nl
EXPO_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/dark
EXPO_PUBLIC_ROUTING_URL=https://routing.openstreetmap.de/routed-foot
EXPO_PUBLIC_CITY_NAME=Amsterdam
EXPO_PUBLIC_CITY_CENTER=52.3606,4.9276
EXPO_PUBLIC_CITY_REPORT_URL=https://meldingen.amsterdam.nl
