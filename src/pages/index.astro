---
import Base from "@/layouts/Base.astro";
import Globe from "@/components/shared/Globe";
import { ASSETS } from "@/lib/assets";

const hotspots = [
  { lat: 22, lon: 20, label: "Inbraakpoging" },
  { lat: -10, lon: -45, label: "Overlast" },
  { lat: 44, lon: -12, label: "Drugsgebruik" },
];

const steps = [
  { n: "01", title: "Meld in twee tikken", body: "Kies wat je ziet en hoe onveilig het voelt. Je locatie wordt vervaagd tot ongeveer 100 meter." },
  { n: "02", title: "Zie de hotspots", body: "De kaart kleurt rood waar het nu speelt en blauw waar het rustig is." },
  { n: "03", title: "Kies een veilige route", body: "Weet wat er speelt voordat je de deur uitgaat, en krijg een seintje bij nieuwe meldingen." },
];
---
<Base title="Safety Map | Zie waar het onveilig is, voordat je er bent" description="Live meldingen uit jouw buurt op een kaart. Meld in twee tikken. Jij blijft anoniem.">
  <nav class="fixed inset-x-0 top-0 z-20 flex items-center justify-between bg-[linear-gradient(rgba(7,11,18,.7),transparent)] px-5 py-4 backdrop-blur-md sm:px-8 sm:py-5">
    <a href="/" class="flex items-center gap-3">
      <img src="/icons/icon-160.png" alt="" width="32" height="32" class="rounded-[9px]" />
      <b class="text-[16px] font-medium tracking-tight">Safety Map</b>
    </a>
    <a href="/app" class="btn glass glass-red h-[42px]! w-auto! px-5 text-[14px] font-medium"><span>Open de app</span></a>
  </nav>

  <main>
    <header class="relative flex min-h-screen flex-col items-center overflow-hidden px-4 pt-[130px] text-center sm:pt-[150px]">
      <div class="absolute inset-0 bg-[url(/img/terrain.jpg)] bg-cover bg-center opacity-[.22] saturate-[1.1]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(120%_90%_at_50%_20%,rgba(7,11,18,.5),rgba(7,11,18,.85)_60%,var(--page))]"></div>
      <div class="relative z-[5] max-w-[720px]">
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3.5 py-1.5 text-[12px] uppercase tracking-[.14em] text-cyan">
          <span class="block h-1.5 w-1.5 rounded-full bg-red shadow-[0_0_8px_var(--red)]"></span>Live in jouw buurt
        </p>
        <h1 class="display text-[clamp(34px,6vw,58px)]">Zie waar het onveilig is,<br />voordat je er bent</h1>
        <p class="mx-auto mt-5 max-w-[520px] text-[clamp(15px,2.2vw,18px)] leading-normal text-[#bcc8d6]">
          Live meldingen uit jouw buurt op een kaart. Meld in twee tikken. Jij blijft anoniem.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/app" class="btn glass glass-red h-[46px]! w-auto! px-6 font-medium"><span>Open de app</span></a>
          <a href="#hoe" class="btn glass h-[46px]! w-auto! px-6 font-medium text-fg"><span>Zo werkt het</span></a>
        </div>
      </div>

      <div class="globe-stage relative z-[2] -mt-2 flex h-[min(96vw,600px)] w-full items-start justify-center">
        <div class="orbit absolute left-1/2 top-1/2 aspect-square w-[clamp(340px,72vw,640px)] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[rgba(56,180,255,.16)]"></div>
        <div class="orbit two absolute left-1/2 top-1/2 aspect-square w-[clamp(300px,62vw,540px)] rounded-full border border-dashed border-[rgba(56,180,255,.1)]">
          <span class="absolute -top-1 left-1/2 block h-[7px] w-[7px] rounded-full bg-cyan shadow-[0_0_12px_var(--cyan)]"></span>
        </div>
        <Globe
          client:visible
          texture={ASSETS.globeTex}
          hotspots={hotspots}
          cameraZ={4.5}
          fov={44}
          className="relative z-[2] block aspect-square w-[clamp(300px,62vw,520px)] drop-shadow-[0_0_120px_rgba(31,120,220,.4)]"
          cardClassName="absolute left-1/2 top-1/2 z-[6] -translate-x-1/2 -translate-y-1/2"
        />
      </div>
    </header>

    <section id="hoe" class="relative z-[5] mx-auto max-w-[1040px] px-6 py-[70px]" aria-label="Zo werkt het">
      <ol class="grid gap-[18px] md:grid-cols-3">
        {steps.map((s) => (
          <li class="rounded-2xl border border-border bg-surface px-[22px] py-[26px] backdrop-blur-sm">
            <span class="text-[12px] uppercase tracking-[.14em] text-cyan">{s.n}</span>
            <h2 class="mt-3.5 mb-2 text-[19px] font-medium tracking-tight">{s.title}</h2>
            <p class="text-[13.5px] leading-normal text-muted">{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="relative z-[5] mx-auto max-w-[1040px] px-6 pb-10" aria-labelledby="privacy-title">
      <div class="grid items-center gap-8 rounded-2xl border border-border bg-surface p-7 md:grid-cols-[1.1fr_1fr] md:p-10">
        <div>
          <p class="text-[12px] uppercase tracking-[.14em] text-cyan">Privacy eerst</p>
          <h2 id="privacy-title" class="display mt-3 text-[clamp(24px,3.4vw,32px)]">Informeren, niet opjagen</h2>
          <p class="mt-4 text-[14px] leading-relaxed text-muted">
            Safety Map laat zien waar iets speelt, niet wie. Categorieën beschrijven gedrag en plekken, nooit personen.
            Iemand die hulp nodig lijkt te hebben, is een hulpsignaal en geen gevaar.
          </p>
        </div>
        <ul class="flex flex-col gap-3 text-[14px]">
          <li class="flex gap-3"><span class="text-cyan">01</span>Locaties vervaagd tot ongeveer 100 meter</li>
          <li class="flex gap-3"><span class="text-cyan">02</span>Geen naam, e-mail of telefoonnummer nodig</li>
          <li class="flex gap-3"><span class="text-cyan">03</span>Geen openbare omschrijvingen</li>
          <li class="flex gap-3"><span class="text-cyan">04</span>Meldingen verdwijnen vanzelf</li>
          <li class="flex gap-3"><span class="text-cyan">05</span>Geen trackers van derden</li>
        </ul>
      </div>
    </section>

    <section class="relative z-[5] px-6 pt-[30px] pb-2.5 text-center">
      <h2 class="display text-[clamp(26px,4vw,38px)]">Jouw buurt, in realtime</h2>
      <div class="mt-6 flex justify-center">
        <a href="/app" class="btn glass glass-red h-[46px]! w-auto! px-6 font-medium"><span>Open de app</span></a>
      </div>
    </section>
  </main>

  <footer class="relative z-[5] mt-[60px] flex flex-wrap items-center justify-between gap-2.5 border-t border-border px-8 py-7 text-[13px] text-muted">
    <span>Safety Map is geen alarmdienst.</span>
    <span>Bij nood: bel altijd <b class="font-medium text-fg">112</b></span>
  </footer>
</Base>

<style>
  .orbit.two {
    animation: orbit 44s linear infinite;
  }
  @keyframes orbit {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
  .globe-stage {
    pointer-events: none;
  }
  .globe-stage :global(canvas) {
    pointer-events: auto;
  }
</style>
